# Backend base URL. Unset = mock mode (MSW). In dev, /api is proxied here (no CORS).
VITE_API_URL=
# Force mocks on/off. Default: true when VITE_API_URL is unset.
VITE_USE_MOCKS=
# Optional basemap override: a MapLibre style URL, a .pmtiles URL, or a {z}/{x}/{y} tile URL.
# Normally the backend's config endpoint decides; this wins if set.
VITE_MAP_STYLE_URL=
